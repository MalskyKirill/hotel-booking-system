{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API error",
  "type": "object",
  "required": [
    "timestamp",
    "status",
    "error",
    "code",
    "message",
    "path",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "error": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
