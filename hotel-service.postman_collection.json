                    ]
                }
            }
        },
        {
            "name": "04. GET /api/hotels — список (200)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Тело — массив', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body).to.be.an('array');",
                            "});",
                            "",
                            "pm.test('Каждый элемент имеет id, name, address', function () {",
                            "    const body = pm.response.json();",
                            "    body.forEach(function (hotel) {",
                            "        pm.expect(hotel).to.have.property('id');",
                            "        pm.expect(hotel).to.have.property('name');",
                            "        pm.expect(hotel).to.have.property('address');",
                            "    });",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/hotels",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "hotels"
                    ]
                }
            }
        },
        {
            "name": "05. GET /api/hotels/{id} — успех (200)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
