        {
            "name": "09. PUT /api/hotels/{id} — не найден (404)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 404 Not Found (НЕ 500!)', function () {",
                            "    pm.response.to.have.status(404);",
                            "});",
                            "",
                            "pm.test('Тело — JSON с status=404 и сообщением', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body).to.have.property('status', 404);",
                            "    pm.expect(body.message).to.include('not found');",
                            "});",
                            "",
                            "pm.test('Это НЕ стандартная ошибка 500 от Spring', function () {",
