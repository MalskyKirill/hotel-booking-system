        {
            "name": "06. GET /api/hotels/{id} — не найден (404)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 404 Not Found', function () {",
                            "    pm.response.to.have.status(404);",
                            "});",
                            "",
                            "pm.test('Тело — JSON с status=404 (НЕ 500!)', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body).to.have.property('status', 404);",
                            "    pm.expect(body).to.have.property('message');",
                            "    pm.expect(body.message).to.include('not found');",
                            "});",
                            "",
                            "pm.test('Тело содержит id запрошенного отеля', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('nonExistentId'));",
