{
    "info": {
        "name": "Hotel Service API",
        "description": "Полный набор тестов для hotel-service: CRUD + валидация + обработка ошибок",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "hotelId",
            "value": "",
            "type": "string"
        },
        {
            "key": "nonExistentId",
            "value": "999999",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "01. POST /api/hotels — создание (успех, 201)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 201 Created', function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test('Content-Type — application/json', function () {",
                            "    pm.response.to.have.header('Content-Type');",
                            "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                            "});",
                            "",
                            "pm.test('Заголовок Location присутствует и указывает на /api/hotels/{id}', function () {",
                            "    pm.response.to.have.header('Location');",
                            "    pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/hotels\\/\\d+$/);",
                            "});",
                            "",
                            "pm.test('Тело содержит id, name, address', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body).to.have.property('id');",
                            "    pm.expect(body).to.have.property('name', 'Hilton');",
                            "    pm.expect(body).to.have.property('address', 'Moscow, Tverskaya 1');",
                            "    pm.expect(body.id).to.be.a('number');",
                            "});",
                            "",
                            "// Сохраняем id созданного отеля для последующих запросов",
                            "const body = pm.response.json();",
                            "pm.collectionVariables.set('hotelId', String(body.id));",
                            "console.log('Создан отель с id =', body.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Hilton\",\n  \"address\": \"Moscow, Tverskaya 1\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/hotels",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "hotels"
                    ]
                }
            }
        },
        {
            "name": "02. POST /api/hotels — пустое имя (400)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 400 Bad Request', function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "",
                            "pm.test('Тело содержит status=400 и описание ошибки', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body).to.have.property('status', 400);",
                            "    pm.expect(JSON.stringify(body)).to.include('name');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
