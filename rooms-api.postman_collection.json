{
    "info": {
        "name": "Room Service API",
        "description": "Тесты для создания номеров и обработки конфликтов уникальности",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "hotelId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "roomId",
            "value": "",
            "type": "string"
        },
        {
            "key": "startDate",
            "value": "2027-01-01"
        },
        {
            "key": "endDate",
            "value": "2027-01-03"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "adminToken",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "01. POST /api/rooms — успешное создание (201)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 201 Created', function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test('Заголовок Location присутствует', function () {",
                            "    pm.response.to.have.header('Location');",
                            "    pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/rooms\\/\\d+$/);",
                            "});",
                            "",
                            "pm.test('Дефолтные значения available=true и timesBooked=0', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body.available).to.eql(true);",
                            "    pm.expect(body.timesBooked).to.eql(0);",
                            "});",
                            "",
                            "// Сохраняем ID созданного номера",
                            "const body = pm.response.json();",
                            "pm.collectionVariables.set('roomId', body.id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"hotelId\": {{hotelId}},\n  \"roomNumber\": \"101\",\n  \"capacity\": 2,\n  \"price\": 4500.00\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/rooms",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms"
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{adminToken}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "02. POST /api/rooms — дубликат номера (409 Precheck)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 409 Conflict', function () {",
                            "    pm.response.to.have.status(409);",
                            "});",
                            "",
                            "pm.test('Код конфликта номера', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body.status).to.eql(409);",
                            "    pm.expect(body.code).to.eql('ROOM_ALREADY_EXISTS');",
                            "    pm.expect(body.message).to.include('already exists');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"hotelId\": {{hotelId}},\n  \"roomNumber\": \"101\",\n  \"capacity\": 2,\n  \"price\": 4500.00\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/rooms",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms"
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{adminToken}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "03. POST /api/rooms — отель не существует (404)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 404 Not Found', function () {",
                            "    pm.response.to.have.status(404);",
                            "});",
                            "",
                            "pm.test('Тело содержит status=404 и упоминание отеля', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body.status).to.eql(404);",
                            "    pm.expect(body.message).to.include('Hotel');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"hotelId\": 999999,\n  \"roomNumber\": \"102\",\n  \"capacity\": 2,\n  \"price\": 4500.00\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/rooms",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms"
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{adminToken}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "04. POST /api/rooms — невалидные данные (400)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 400 Bad Request', function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "",
                            "pm.test('Валидация отловила пустой номер и отрицательную цену', function () {",
                            "    const body = pm.response.json();",
                            "    pm.expect(body.status).to.eql(400);",
                            "    pm.expect(body.fields).to.have.property('roomNumber');",
                            "    pm.expect(body.fields).to.have.property('price');",
                            "    pm.expect(body.fields).to.have.property('capacity');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"hotelId\": {{hotelId}},\n  \"roomNumber\": \"   \",\n  \"capacity\": -1,\n  \"price\": -100.00\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/rooms",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms"
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{adminToken}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "05. GET /api/rooms — все доступные (200)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Тело является массивом', function () {",
                            "    pm.expect(pm.response.json()).to.be.an('array');",
                            "});",
                            "",
                            "pm.test('Все возвращенные номера доступны (available=true)', function () {",
                            "    const rooms = pm.response.json();",
                            "    rooms.forEach(function (room) {",
                            "        pm.expect(room.available).to.eql(true);",
                            "    });",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/rooms?startDate={{startDate}}&endDate={{endDate}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms"
                    ],
                    "query": [
                        {
                            "key": "startDate",
                            "value": "{{startDate}}"
                        },
                        {
                            "key": "endDate",
                            "value": "{{endDate}}"
                        }
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "06. GET /api/rooms?hotelId={{hotelId}} — по отелю (200)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Возвращены только номера запрошенного отеля', function () {",
                            "    const rooms = pm.response.json();",
                            "    const expectedHotelId = parseInt(pm.collectionVariables.get('hotelId'));",
                            "    if (rooms.length > 0) {",
                            "        rooms.forEach(function (room) {",
                            "            pm.expect(room.hotelId).to.eql(expectedHotelId);",
                            "            pm.expect(room.available).to.eql(true);",
                            "        });",
                            "    }",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/rooms?hotelId={{hotelId}}&startDate={{startDate}}&endDate={{endDate}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms"
                    ],
                    "query": [
                        {
                            "key": "hotelId",
                            "value": "{{hotelId}}"
                        },
                        {
                            "key": "startDate",
                            "value": "{{startDate}}"
                        },
                        {
                            "key": "endDate",
                            "value": "{{endDate}}"
                        }
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "07. GET /api/rooms?hotelId=999999 — несуществующий отель (200)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 200 OK (это не ошибка 404)', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Тело — пустой массив []', function () {",
                            "    const rooms = pm.response.json();",
                            "    pm.expect(rooms).to.be.an('array');",
                            "    pm.expect(rooms.length).to.eql(0);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/rooms?hotelId=999999&startDate={{startDate}}&endDate={{endDate}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms"
                    ],
                    "query": [
                        {
                            "key": "hotelId",
                            "value": "999999"
                        },
                        {
                            "key": "startDate",
                            "value": "{{startDate}}"
                        },
                        {
                            "key": "endDate",
                            "value": "{{endDate}}"
                        }
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "08. GET /api/rooms/recommend — рекомендации (200)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "const rooms = pm.response.json();",
                            "",
                            "pm.test('Тело является массивом', function () {",
                            "    pm.expect(rooms).to.be.an('array');",
                            "});",
                            "",
                            "pm.test('Все номера операционно доступны (available=true)', function () {",
                            "    rooms.forEach(function (room) {",
                            "        pm.expect(room.available).to.eql(true);",
                            "    });",
                            "});",
                            "",
                            "pm.test('Сортировка: timesBooked ASC, затем id ASC', function () {",
                            "    // Проверяем порядок только если в массиве больше 1 элемента",
                            "    if (rooms.length > 1) {",
                            "        for (let i = 0; i < rooms.length - 1; i++) {",
                            "            const current = rooms[i];",
                            "            const next = rooms[i + 1];",
                            "",
                            "            // 1. Текущий timesBooked должен быть <= следующего",
                            "            pm.expect(current.timesBooked).to.be.at.most(next.timesBooked);",
                            "",
                            "            // 2. Если timesBooked равны, то текущий id должен быть < следующего",
                            "            if (current.timesBooked === next.timesBooked) {",
                            "                pm.expect(current.id).to.be.below(next.id);",
                            "            }",
                            "        }",
                            "    }",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/rooms/recommend?startDate={{startDate}}&endDate={{endDate}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms",
                        "recommend"
                    ],
                    "query": [
                        {
                            "key": "startDate",
                            "value": "{{startDate}}"
                        },
                        {
                            "key": "endDate",
                            "value": "{{endDate}}"
                        }
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                }
            }
        },
        {
            "name": "09. GET /api/rooms/recommend?hotelId={{hotelId}} — по отелю (200)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Статус 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "const rooms = pm.response.json();",
                            "",
                            "pm.test('Тело является массивом', function () {",
                            "    pm.expect(rooms).to.be.an('array');",
                            "});",
                            "",
                            "pm.test('Все номера принадлежат запрошенному отелю', function () {",
                            "    const expectedHotelId = parseInt(pm.collectionVariables.get('hotelId'));",
                            "    rooms.forEach(function (room) {",
                            "        pm.expect(room.hotelId).to.eql(expectedHotelId);",
                            "    });",
                            "});",
                            "",
                            "pm.test('Все номера доступны (available=true)', function () {",
                            "    rooms.forEach(function (room) {",
                            "        pm.expect(room.available).to.eql(true);",
                            "    });",
                            "});",
                            "",
                            "pm.test('Сортировка: timesBooked ASC, затем id ASC', function () {",
                            "    if (rooms.length > 1) {",
                            "        for (let i = 0; i < rooms.length - 1; i++) {",
                            "            const current = rooms[i];",
                            "            const next = rooms[i + 1];",
                            "            pm.expect(current.timesBooked).to.be.at.most(next.timesBooked);",
                            "            if (current.timesBooked === next.timesBooked) {",
                            "                pm.expect(current.id).to.be.below(next.id);",
                            "            }",
                            "        }",
                            "    }",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/rooms/recommend?hotelId={{hotelId}}&startDate={{startDate}}&endDate={{endDate}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "rooms",
                        "recommend"
                    ],
                    "query": [
                        {
                            "key": "hotelId",
                            "value": "{{hotelId}}"
                        },
                        {
                            "key": "startDate",
                            "value": "{{startDate}}"
                        },
                        {
                            "key": "endDate",
                            "value": "{{endDate}}"
                        }
                    ]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{token}}",
                            "type": "string"
                        }
                    ]
                }
            }
        }
    ]
}
